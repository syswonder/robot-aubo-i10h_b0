# Copy to .env (not committed) and adjust for this host.
# AUBO controller address (arm RPC and the vision service).
AUBO_HOST=
# Robonix tree mounted at /opt/robonix; needs target/release built.
ROBONIX_SOURCE=$HOME/robonix
ROBONIX_AUBO_IMAGE=robonix-aubo:20260922
# 0600 JSON file {"username": ..., "password": ...} for the AUBO SDK.
AUBO_CREDENTIALS_FILE=$HOME/.config/aubo/sdk-credentials.json
# USB-RS485 adapter wired to the gripper; prefer /dev/serial/by-id/... .
GRIPPER_DEVICE=/dev/ttyUSB0
# A real model for Pilot; leave unset to use the scripted fake VLM.
# VLM_BASE_URL=
# VLM_API_KEY=
# VLM_MODEL=
